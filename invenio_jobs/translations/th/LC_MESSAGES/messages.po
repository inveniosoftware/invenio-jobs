msgid ""
"YYYY-MM-DDThh:mm:ss+00:00 format (ISO 8601 in UTC). Leave empty to continue "
"since last successful run."
msgstr ""
"รูปแบบ YYYY-MM-DDThh:mm:ss+00:00 (ISO 8601 ใน UTC) "
"เว้นว่างเพื่อดำเนินการต่อจากการรันที่สำเร็จล่าสุด"

#: invenio_jobs/utils.py:78
msgid "Job Completed Successfully"
msgstr "งานเสร็จสมบูรณ์"

#: invenio_jobs/utils.py:79
#, python-brace-format
msgid "Job '{title}' has completed successfully."
msgstr "งาน '{title}' เสร็จสมบูรณ์แล้ว"

#: invenio_jobs/utils.py:83
#, python-brace-format
msgid ""
"Great news! The job '{title}' has finished running and completed "
"successfully."
msgstr "ข่าวดี! งาน '{title}' รันเสร็จและสำเร็จแล้ว"

#: invenio_jobs/utils.py:85
msgid "You can review the results by clicking the button below."
msgstr "คุณสามารถตรวจสอบผลลัพธ์โดยคลิกปุ่มด้านล่าง"

#: invenio_jobs/utils.py:89
msgid "Job Failed"
msgstr "งานล้มเหลว"

#: invenio_jobs/utils.py:90
#, python-brace-format
msgid "Job '{title}' has failed."
msgstr "งาน '{title}' ล้มเหลว"

#: invenio_jobs/utils.py:92
#, python-brace-format
msgid ""
"Unfortunately, the job '{title}' encountered an error and could not "
"complete."
msgstr ""
"น่าเสียดาย งาน '{title}' พบข้อผิดพลาดและไม่สามารถดำเนินการให้เสร็จสมบูรณ์ได้"

#: invenio_jobs/utils.py:95
msgid ""
"Please review the details below or contact your system administrator if you "
"need assistance."
msgstr ""
"โปรดตรวจสอบรายละเอียดด้านล่างหรือติดต่อผู้ดูแลระบบหากต้องการความช่วยเหลือ"

#: invenio_jobs/utils.py:100
msgid "Job Completed with Errors"
msgstr "งานเสร็จสิ้นแต่มีข้อผิดพลาด"

#: invenio_jobs/utils.py:101
#, python-brace-format
msgid "Job '{title}' completed but encountered errors."
msgstr "งาน '{title}' เสร็จสิ้นแต่พบข้อผิดพลาด"

#: invenio_jobs/utils.py:105
#, python-brace-format
msgid "The job '{title}' has finished, but some items could not be processed."
msgstr "งาน '{title}' เสร็จสิ้นแล้ว แต่บางรายการไม่สามารถประมวลผลได้"

#: invenio_jobs/utils.py:108
msgid ""
"Please review which items failed and take appropriate action if needed."
msgstr "โปรดตรวจสอบรายการที่ล้มเหลวและดำเนินการที่เหมาะสมหากจำเป็น"

#: invenio_jobs/utils.py:117
#, python-brace-format
msgid "Job Status: {status}"
msgstr "สถานะงาน: {status}"

#: invenio_jobs/utils.py:118
#, python-brace-format
msgid "Job '{title}' status: {status}"
msgstr "สถานะงาน '{title}': {status}"

#: invenio_jobs/utils.py:122
#, python-brace-format
msgid "The job '{title}' has a status update: {status}"
msgstr "งาน '{title}' มีการอัปเดตสถานะ: {status}"

#: invenio_jobs/utils.py:124
msgid "Please review the details below for more information."
msgstr "โปรดตรวจสอบรายละเอียดด้านล่างสำหรับข้อมูลเพิ่มเติม"

#: invenio_jobs/administration/jobs.py:39
msgid "Schedule"
msgstr "กำหนดการ"

