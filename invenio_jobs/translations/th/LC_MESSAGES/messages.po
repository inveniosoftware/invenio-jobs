msgid "Ascending"
msgstr "จากน้อยไปมาก"

#: invenio_jobs/services/config.py:42 invenio_jobs/services/config.py:79
#: invenio_jobs/services/config.py:124 invenio_jobs/services/config.py:167
msgid "Descending"
msgstr "จากมากไปน้อย"

