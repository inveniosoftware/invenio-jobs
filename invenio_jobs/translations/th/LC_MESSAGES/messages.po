#: invenio_jobs/administration/jobs.py:97
msgid "Message"
msgstr "ข้อความ"

#: invenio_jobs/administration/jobs.py:99
msgid "Action"
msgstr "การดำเนินการ"

#: invenio_jobs/administration/jobs.py:140 invenio_jobs/services/config.py:81
msgid "Title"
msgstr "ชื่อเรื่อง"

#: invenio_jobs/administration/jobs.py:141
msgid "A title of the job."
msgstr "ชื่อของงาน"

#: invenio_jobs/administration/jobs.py:145
msgid "Description"
msgstr "คำอธิบาย"

#: invenio_jobs/administration/jobs.py:146
msgid "A short description about the job."
msgstr "คำอธิบายสั้นๆ เกี่ยวกับงาน"

#: invenio_jobs/administration/jobs.py:150
msgid "Queue"
msgstr "คิว"

#: invenio_jobs/administration/jobs.py:151
msgid "A queue for the job run."
msgstr "คิวสำหรับการรันงาน"

#: invenio_jobs/administration/jobs.py:157
msgid "Task"
msgstr "งาน"

#: invenio_jobs/administration/jobs.py:158
msgid "A task for the job run."
msgstr "งานสำหรับการรัน"

#: invenio_jobs/administration/jobs.py:164
msgid "Active"
msgstr "ใช้งานอยู่"

#: invenio_jobs/administration/jobs.py:168
msgid "Notification emails"
msgstr "อีเมลการแจ้งเตือน"

#: invenio_jobs/administration/jobs.py:170
msgid ""
"Email addresses to notify about this job's status. Leave empty to disable "
"notifications."
msgstr "ที่อยู่อีเมลสำหรับแจ้งเตือนสถานะงานนี้ เว้นว่างเพื่อปิดการแจ้งเตือน"

#: invenio_jobs/administration/jobs.py:179
msgid "Notification statuses"
msgstr "สถานะการแจ้งเตือน"

#: invenio_jobs/administration/jobs.py:181
msgid ""
"Which run statuses should trigger email notifications. Leave empty to "
"disable notifications."
msgstr ""
"สถานะการรันใดที่ควรส่งการแจ้งเตือนทางอีเมล เว้นว่างเพื่อปิดการแจ้งเตือน"

#: invenio_jobs/administration/jobs.py:238
msgid "Current Job Configuration"
msgstr "การกำหนดค่างานปัจจุบัน"

#: invenio_jobs/administration/jobs.py:239
msgid "The configuration used for this Job."
msgstr "การกำหนดค่าที่ใช้สำหรับงานนี้"

#: invenio_jobs/administration/jobs.py:243
msgid "Custom Arguments"
msgstr "อาร์กิวเมนต์แบบกำหนดเอง"

#: invenio_jobs/administration/jobs.py:245
msgid ""
"When provided, the input below will override any arguments specified above."
msgstr "เมื่อระบุแล้ว ข้อมูลด้านล่างจะแทนที่อาร์กิวเมนต์ที่ระบุไว้ด้านบน"

#: invenio_jobs/services/config.py:38 invenio_jobs/services/config.py:78
