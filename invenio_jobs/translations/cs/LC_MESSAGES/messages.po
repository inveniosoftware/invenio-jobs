#: invenio_jobs/services/errors.py:25
#, python-format
msgid "Job with ID %(id)s does not exist."
msgstr "Úloha s ID %(id)s neexistuje."

#: invenio_jobs/services/errors.py:33
#, python-format
msgid "Run with ID %(id)s does not exist."
msgstr "Run s ID %(id)s neexistuje."

#: invenio_jobs/services/errors.py:36
#, python-format
msgid "Run with ID %(id)s for job %(job_id)s does not exist."
msgstr "Run s ID %(id)s pro úlohu %(job_id)s neexistuje."

#: invenio_jobs/services/errors.py:52
#, python-format
msgid "You cannot change run status from %(old)s to %(new)s."
msgstr "Nemůžete změnit stavy běhu z %(old)s na %(new)s ."

#: invenio_jobs/services/errors.py:66
#, python-format
msgid ""
"Too many log results returned (%(total)s). The maximum allowed is "
"%(max_docs)s. Please refine your search criteria to reduce the result size."
msgstr ""
"Bylo nalezeno příliš mnoho záznamů o operacích (%(total)s). Maximální "
"povolený počet je %(max_docs)s. Zpřesněte prosím kritéria vyhledávání, "
"abyste zmenšili množství výsledků."

#: invenio_jobs/services/results.py:183
#, python-format
msgid ""
"Too many log results returned (%(total)s). Only the most recent %(max)s "
"results are shown."
msgstr ""
"Bylo nalezeno příliš mnoho záznamů o operacích (%(total)s). Zobrazeny pouze "
"nejnovější výsledky %(max)s ."

#: invenio_jobs/services/schema.py:31
#, python-format
msgid "Field cannot be blank or longer than %(max_)s characters."
msgstr "Pole nemůže být prázdné nebo delší než %(max_)s znaků."

