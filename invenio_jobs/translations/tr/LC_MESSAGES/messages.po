#: invenio_jobs/utils.py:78
msgid "Job Completed Successfully"
msgstr "Görev başarıyla tamamlandı"

#: invenio_jobs/utils.py:79
#, python-brace-format
msgid "Job '{title}' has completed successfully."
msgstr "'{title}' görevi başarıyla tamamlandı."

#: invenio_jobs/utils.py:83
#, python-brace-format
msgid ""
"Great news! The job '{title}' has finished running and completed "
"successfully."
msgstr ""
"Harika bir haber! '{title}' görevi çalışmasını tamamladı ve başarıyla "
"sonuçlandı."

#: invenio_jobs/utils.py:85
msgid "You can review the results by clicking the button below."
msgstr "Sonuçları incelemek için aşağıdaki düğmeye tıklayabilirsiniz."

#: invenio_jobs/utils.py:89
msgid "Job Failed"
msgstr "Görev başarısız oldu"

#: invenio_jobs/utils.py:90
#, python-brace-format
msgid "Job '{title}' has failed."
msgstr "'{title}' görevi başarısız oldu"

#: invenio_jobs/utils.py:92
#, python-brace-format
msgid ""
"Unfortunately, the job '{title}' encountered an error and could not "
"complete."
msgstr "Maalesef, '{title}' görevi bir hatayla karşılaştı ve tamamlanamadı."

#: invenio_jobs/utils.py:95
msgid ""
"Please review the details below or contact your system administrator if you "
"need assistance."
msgstr ""
"Lütfen aşağıdaki ayrıntıları inceleyin veya yardıma ihtiyacınız varsa sistem"
" yöneticinizle iletişime geçin."

#: invenio_jobs/utils.py:100
msgid "Job Completed with Errors"
msgstr "Görev Hatalar ile Tamamlandı"

#: invenio_jobs/utils.py:101
#, python-brace-format
msgid "Job '{title}' completed but encountered errors."
msgstr "'{title}' görevi tamamlandı, ancak bazı hatalar oluştu."

#: invenio_jobs/utils.py:105
#, python-brace-format
msgid "The job '{title}' has finished, but some items could not be processed."
msgstr "'{title}' görevi tamamlandı, ancak bazı öğeler işlenemedi."

#: invenio_jobs/utils.py:108
msgid ""
"Please review which items failed and take appropriate action if needed."
msgstr ""
"Lütfen işlenemeyen öğeleri inceleyin ve gerekirse uygun işlemleri "
"gerçekleştirin."

#: invenio_jobs/utils.py:117
#, python-brace-format
