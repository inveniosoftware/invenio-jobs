#: invenio_jobs/jobs.py:38
msgid ""
"YYYY-MM-DDThh:mm:ss+00:00 format (ISO 8601 in UTC). Leave empty to continue "
"since last successful run."
msgstr ""
"Format: YYYY-MM-DDThh:mm:ss+00:00 (ISO 8601 in UTC). Leer lassen, um den "
"letzten erfolgreichen Durchlauf fortzusetzen."

#: invenio_jobs/utils.py:78
msgid "Job Completed Successfully"
msgstr "Auftrag erfolgreich abgeschlossen"

#: invenio_jobs/utils.py:79
#, python-brace-format
msgid "Job '{title}' has completed successfully."
msgstr "Der Auftrag „{title}\" wurde erfolgreich abgeschlossen."

#: invenio_jobs/utils.py:83
#, python-brace-format
msgid ""
"Great news! The job '{title}' has finished running and completed "
"successfully."
msgstr ""
"Gute Nachrichten! Der Auftrag „{title}\" wurde ausgeführt und erfolgreich "
"abgeschlossen."

#: invenio_jobs/utils.py:85
msgid "You can review the results by clicking the button below."
msgstr ""
"Sie können die Ergebnisse überprüfen, indem Sie auf die Schaltfläche unten "
"klicken."

#: invenio_jobs/utils.py:89
msgid "Job Failed"
msgstr "Auftrag fehlgeschlagen"

#: invenio_jobs/utils.py:90
#, python-brace-format
msgid "Job '{title}' has failed."
msgstr "Der Auftrag „{title}\" ist fehlgeschlagen."

#: invenio_jobs/utils.py:92
#, python-brace-format
msgid ""
"Unfortunately, the job '{title}' encountered an error and could not "
"complete."
msgstr ""
"Leider ist beim Auftrag „{title}\" ein Fehler aufgetreten und er konnte "
"nicht abgeschlossen werden."

#: invenio_jobs/utils.py:95
msgid ""
"Please review the details below or contact your system administrator if you "
"need assistance."
msgstr ""
"Bitte überprüfen Sie die untenstehenden Details oder wenden Sie sich an "
"Ihre*n Systemadministrator*in, wenn Sie Hilfe benötigen."

#: invenio_jobs/utils.py:100
msgid "Job Completed with Errors"
msgstr "Auftrag mit Fehlern abgeschlossen"

#: invenio_jobs/utils.py:101
#, python-brace-format
msgid "Job '{title}' completed but encountered errors."
msgstr ""
"Der Auftrag „{title}\" wurde abgeschlossen, ist jedoch auf Fehler gestoßen."

#: invenio_jobs/utils.py:105
#, python-brace-format
msgid "The job '{title}' has finished, but some items could not be processed."
msgstr ""
"Der Auftrag „{title}\" ist beendet, aber einige Elemente konnten nicht "
"verarbeitet werden."

#: invenio_jobs/utils.py:108
msgid ""
"Please review which items failed and take appropriate action if needed."
msgstr ""
"Bitte überprüfen Sie, welche Elemente fehlgeschlagen sind, und ergreifen Sie"
" bei Bedarf entsprechende Maßnahmen."

#: invenio_jobs/utils.py:117
#, python-brace-format
