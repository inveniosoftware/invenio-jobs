msgstr ""
"Sie können den Status eines Durchlaufs von %(old)s auf %(new)s nicht ändern."

#: invenio_jobs/services/errors.py:66
#, python-format
msgid ""
"Too many log results returned (%(total)s). The maximum allowed is "
"%(max_docs)s. Please refine your search criteria to reduce the result size."
msgstr ""
"Zu viele Protokollergebnisse zurückgegeben (%(total)s). Das Maximum beträgt "
"%(max_docs)s. Bitte verfeinern Sie Ihre Suchkriterien, um die Ergebnismenge "
"zu reduzieren."

#: invenio_jobs/services/results.py:183
#, python-format
msgid ""
"Too many log results returned (%(total)s). Only the most recent %(max)s "
"results are shown."
msgstr ""
"Zu viele Protokollergebnisse zurückgegeben (%(total)s). Es werden nur die "
"neuesten %(max)s Ergebnisse angezeigt."

#: invenio_jobs/services/schema.py:31
#, python-format
msgid "Field cannot be blank or longer than %(max_)s characters."
msgstr "Feld darf nicht leer oder länger als %(max_)s Zeichen sein."

